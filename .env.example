# Runtime LLM access — only needed if the APP ITSELF calls a model while a user
# is using it. This is unrelated to your GitHub Copilot licence: Copilot writes
# your code, this calls a model at runtime. See docs/AI-SETUP.md.
#
# Provider-agnostic: any OpenAI-compatible endpoint works. Set all three.
#
# NOTE: GitHub Models (models.github.ai) was RETIRED on 2026-07-30 and no
# longer works with any token. Do not use it.

# Company-internal or Azure Foundry endpoint (preferred — ask your organisers):
#   AI_BASE_URL=https://<resource>.services.ai.azure.com/models
# OpenAI direct:
#   AI_BASE_URL=https://api.openai.com/v1
AI_BASE_URL=

AI_TOKEN=

# Model id as your provider names it, e.g. gpt-4o-mini, gpt-4o,
# or azure/<deployment-name>.
AI_MODEL=gpt-4o-mini

# Set to 1 to surface the real upstream error as `debug` in the API response.
# Useful while wiring a provider up. NEVER leave this on for the demo.
AI_DEBUG=0
