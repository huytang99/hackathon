# Token for GitHub Models (runtime LLM calls made BY the app).
# Create at: GitHub > Settings > Developer settings > Personal access tokens
#   > Fine-grained token, scope: models:read
# This is NOT your Copilot licence - different product. See docs/AI-SETUP.md.
GITHUB_MODELS_TOKEN=

# Optional. Defaults to openai/gpt-4o-mini.
AI_MODEL=openai/gpt-4o-mini
